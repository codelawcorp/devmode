{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Start Devmode Workspace",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "start",
        "magzim21",
        "employer-navigator",
        "employer-navigator" // assuming default namespace, change if needed
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "LOG_LEVEL": "DEBUG",
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: List Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": ["list"],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "LOG_LEVEL": "DEBUG",
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Delete Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "delete",
        "magzim21",
        "employer-navigator"
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "LOG_LEVEL": "DEBUG",
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Recreate Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "recreate",
        "employer-navigator-mblp7t3v33mf-devmode",
        "employer-navigator"
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "LOG_LEVEL": "DEBUG",
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Debug pytest",
      "type": "python",
      "request": "launch", // or attach
      "module": "pytest", // insteald of "program"
      "args": ["--rootdir=", "${workspaceFolder}/devmode"],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "LOG_LEVEL": "DEBUG",
        // "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
