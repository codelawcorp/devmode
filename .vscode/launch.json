{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Start Devmode Workspace",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "start",
        "risk-rule-engine-server",
        "human-risk" // assuming default namespace, change if needed
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: List Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": ["list"],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Delete Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "delete",
        "risk-rule-engine-server-mblp7t3v33mf-devmode",
        "human-risk"
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        // "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Recreate Devmode Workspaces",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/devmode.py",
      "args": [
        "recreate",
        "risk-rule-engine-server-mblp7t3v33mf-devmode",
        "human-risk"
      ],
      // "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        // "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
